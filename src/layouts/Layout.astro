---
import '../styles/global.css';
import config from '../data/config.json';
import communes from '../data/communes.json';
import ExitIntentPopup from '../components/ExitIntentPopup.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  activeTab?: string;
}

const { 
  title = "Monte-Escalier Pyrénées-Orientales : Devis Gratuit & Installateur 66", 
  description = "Comparez gratuitement les installateurs de monte-escaliers dans les Pyrénées-Orientales (66). Estimation d'aides (ANAH, APA 66), tarifs droits & courbes, devis rapides.", 
  canonicalUrl,
  activeTab
} = Astro.props;

const currentYear = new Date().getFullYear();
const normalizedPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = canonicalUrl || `https://${config.domain}${normalizedPath}`;

// Top 8 populated communes to display in the footer
const topCommunes = communes.slice(0, 8);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://monte-escalier-pyrenees-orientales.fr/images/hero-monte-escalier-pyrenees-orientales.png" />
    
    <meta name="robots" content="index, follow" />
  </head>
  <body>
    <header>
      <div class="container header-inner">
        <a href="/" class="logo">
          <span>☀️</span> Monte-Escalier 66
        </a>
        <nav class="header-nav" aria-label="Menu principal">
          <a href="/" class={activeTab === 'home' ? 'active' : ''}>Accueil</a>
          <a href="/guide-aides-monte-escalier-66/" class={activeTab === 'aides' ? 'active' : ''}>💶 Aides 66</a>
          <a href="/monte-escalier-mas-catalan/" class={activeTab === 'catalan' ? 'active' : ''}>🏡 Maison Catalan</a>
          <a href="/tarifs/" class={activeTab === 'tarifs' ? 'active' : ''}>Tarifs 2026</a>
          <a href="/communes/" class={activeTab === 'communes' ? 'active' : ''}>Villes 66</a>
        </nav>
        <div>
          <a href="/devis/" class="btn-primary header-cta">Estimer mes aides &rarr;</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container footer-grid">
        <div class="footer-brand">
          <h3 style="margin-bottom:15px;">☀️ Monte-Escalier Pyrénées-Orientales</h3>
          <p style="font-size:15px; color:#A8A29E; line-height:1.6; margin-bottom:20px;">
            Le portail indépendant de comparaison pour sécuriser le maintien à domicile des seniors dans le département des Pyrénées-Orientales (66). Estimation gratuite de subventions (MaPrimeAdapt', APA 66, Crédit d'impôt).
          </p>
          <p style="font-size:14px; color:#78716C;">
            Une initiative solidaire pour l'accessibilité senior en Occitanie (Roussillon, Côte Vermeille, Vallespir & Cerdagne).
          </p>
        </div>
        
        <div class="footer-links">
          <h3>Top Villes du 66</h3>
          <ul>
            {topCommunes.map(c => (
              <li>
                <a href={`/monte-escalier-${c.slug}/`}>Monte-escalier {c.nom} ({c.codePostal})</a>
              </li>
            ))}
          </ul>
        </div>
        
        <div class="footer-links">
          <h3>Guides & Infos</h3>
          <ul>
            <li><a href="/guide-aides-monte-escalier-66/">Grille des aides financières 2026</a></li>
            <li><a href="/monte-escalier-mas-catalan/">Solutions pour mas catalan ancien</a></li>
            <li><a href="/tarifs/">Grille de prix par modèle</a></li>
            <li><a href="/communes/">Annuaire des communes du 66</a></li>
            <li><a href="/politique-confidentialite/">Politique de confidentialité</a></li>
            <li><a href="/mentions-legales/">Mentions légales</a></li>
          </ul>
        </div>
      </div>
      
      <div class="container footer-bottom">
        <p>&copy; {currentYear} monte-escalier-pyrenees-orientales.fr. Tous droits réservés.</p>
        <p style="font-size:13px; color:#78716C;">
          Comparateur gratuit sans engagement. Les estimations d'aides sont fournies à titre indicatif sous réserve d'audit technique RGE à domicile.
        </p>
      </div>
    </footer>

    <ExitIntentPopup />
  </body>
</html>
